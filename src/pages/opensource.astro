---
import BaseLayout from "../layouts/BaseLayout.astro";
import { ogImageSet, opensourceProjects } from "../data/site";
---

<BaseLayout
  title="Opensource"
  description="Opensource projects by Rajender Joshi: port, react-timer-hook, and runrate."
  pageType="collection"
  {...ogImageSet("static", "opensource")}
>
  <section class="container pt-14 sm:pt-18">
    <div class="mt-16">
      <p class="font-mono text-sm text-muted">opensource</p>
      <h1 class="mt-5 text-2xl font-500 leading-tight">Small tools for problems I kept meeting in real work.</h1>
      <p class="mt-6 text-base leading-7 text-muted">
        A small collection of packages, experiments, and utilities from problems I have worked through in public.
      </p>
    </div>
  </section>

  <section class="container section">
    <div class="space-y-12">
      {opensourceProjects.map((project) => (
        <article id={project.slug}>
          <div class="grid gap-1 sm:grid-cols-[1fr_9rem] sm:items-baseline">
            <a class="transition-colors text-xl font-500 no-underline hover:text-ink" href={`/opensource/${project.slug}/`}>
              <span class="animated-text">{project.name}</span>
            </a>
            <div class="flex gap-3 font-mono text-xs leading-6 text-muted sm:justify-end">
              <a class="animated-link transition-colors hover:text-ink" href={project.href}>github</a>
              <a class="animated-link transition-colors hover:text-ink" href={project.npmHref}>npm</a>
            </div>
            <p class="mt-3 text-sm leading-6 text-muted">{project.summary}</p>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
