---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { ogImageSet, opensourceProjects } from "../../data/site";

export function getStaticPaths() {
  return opensourceProjects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const canonicalPath = `/opensource/${project.slug}/`;
const canonicalUrl = `https://rajender.pro${canonicalPath}`;
const images = ogImageSet("opensource", project.slug);
const softwareSchema = {
  "@type": "SoftwareSourceCode",
  "@id": `${canonicalUrl}#software`,
  name: project.name,
  description: project.summary,
  url: canonicalUrl,
  codeRepository: project.href,
  programmingLanguage: "TypeScript",
  author: { "@id": "https://rajender.pro/#person" },
  creator: { "@id": "https://rajender.pro/#person" },
  mainEntityOfPage: { "@id": `${canonicalUrl}#webpage` },
  isAccessibleForFree: true,
};
---

<BaseLayout
  title={project.name}
  description={project.summary}
  canonicalPath={canonicalPath}
  pageType="software"
  imageAlt={`${project.name} opensource project by Rajender Joshi`}
  schema={[softwareSchema]}
  {...images}
>
  <article class="container section pt-8">
    <header class="max-w-3xl">
      <a class="animated-link transition-colors font-mono text-sm text-muted hover:text-ink" href="/opensource/">← opensource</a>
      <h1 class="mt-5 text-3xl font-500 leading-tight">{project.name}</h1>
      <p class="mt-5 text-base leading-7 text-muted">{project.summary}</p>
      <div class="mt-6 flex gap-4 font-mono text-xs text-muted">
        <a class="animated-link transition-colors hover:text-ink" href={project.href}>github</a>
        <a class="animated-link transition-colors hover:text-ink" href={project.npmHref}>npm</a>
        <a class="animated-link transition-colors hover:text-ink" href={project.blogHref}>blog</a>
      </div>
    </header>

    <div class="prose mt-12">
      {project.sections.map((section) => (
        <>
          <h2>{section.title}</h2>
          {section.body.map((paragraph) => <p>{paragraph}</p>)}
        </>
      ))}
      <h2>Usage samples</h2>
      {project.usageSamples.map((sample) => (
        <>
          <h3>{sample.title}</h3>
          <p>{sample.body}</p>
          <pre><code class={`language-${sample.language}`}>{sample.code}</code></pre>
        </>
      ))}
    </div>
  </article>
</BaseLayout>
