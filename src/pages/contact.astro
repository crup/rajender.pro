---
import BaseLayout from "../layouts/BaseLayout.astro";
import { ogImageSet, person } from "../data/site";
---

<BaseLayout
  title="Contact"
  description="Contact Rajender Joshi by email, X, LinkedIn, or GitHub for engineering leadership, platform strategy, and product systems conversations."
  {...ogImageSet("static", "contact")}
>
  <section class="container pt-14 sm:pt-18">
    <div>
      <p class="font-mono text-sm text-muted">contact</p>
      <h1 class="mt-5 text-2xl font-500 leading-tight">Reach me directly.</h1>
      <p class="mt-6 text-base leading-7 text-muted">
        I am usually open to serious conversations around AI products, engineering systems, open source, and team leadership. Email works best for anything that needs context; GitHub and X are better for quick notes around code or writing.
      </p>
    </div>
  </section>

  <section class="container section">
    <div class="grid gap-6 sm:grid-cols-[7.5rem_1fr]">
      <p class="m-0 font-mono text-xs text-muted">contact</p>
      <div class="space-y-5">
        <article class="grid gap-1 sm:grid-cols-[1fr_12rem] sm:items-baseline">
          <span class="text-base leading-6">Email</span>
          <a class="animated-link transition-colors justify-self-start font-mono text-xs leading-6 text-muted hover:text-ink sm:justify-self-end sm:text-right" href={`mailto:${person.email}`}>{person.email}</a>
        </article>
        <article class="grid gap-1 sm:grid-cols-[1fr_12rem] sm:items-baseline">
          <span class="text-base leading-6">GitHub</span>
          <a class="animated-link transition-colors justify-self-start font-mono text-xs leading-6 text-muted hover:text-ink sm:justify-self-end sm:text-right" href={person.github}>@crup</a>
        </article>
        <article class="grid gap-1 sm:grid-cols-[1fr_12rem] sm:items-baseline">
          <span class="text-base leading-6">X</span>
          <a class="animated-link transition-colors justify-self-start font-mono text-xs leading-6 text-muted hover:text-ink sm:justify-self-end sm:text-right" href={person.x}>@_rajenderjoshi</a>
        </article>
        <article class="grid gap-1 sm:grid-cols-[1fr_12rem] sm:items-baseline">
          <span class="text-base leading-6">LinkedIn</span>
          <a class="animated-link transition-colors justify-self-start font-mono text-xs leading-6 text-muted hover:text-ink sm:justify-self-end sm:text-right" href={person.linkedin}>rajenderjoshi</a>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>
