---
import { person } from "../data/site";
const current = Astro.url.pathname;
---

<header class="container pt-16 pb-8 sm:pt-18 sm:pb-10">
  <div class="flex items-start justify-between gap-6">
    <a href="/" class="flex items-start gap-3 no-underline">
      <img
        src="/rajender-joshi-portrait.jpg"
        alt="Rajender Joshi"
        width="40"
        height="40"
        class="mt-0.5 h-10 w-10 shrink-0 rounded-lg object-cover"
        loading="eager"
        decoding="async"
      />
      <span>
        <span class="block text-base font-500 text-ink">{person.name}</span>
        <span class="block text-sm leading-6 text-muted">Engineering leader</span>
      </span>
    </a>
    <nav class="flex gap-5 font-mono text-sm text-muted" aria-label="Primary">
      <a
        class="animated-link transition-colors hover:text-ink"
        aria-current={current.startsWith("/opensource") ? "page" : undefined}
        href="/opensource/"
      >
        opensource
      </a>
      <a
        class="animated-link transition-colors hover:text-ink"
        aria-current={current.startsWith("/blog") ? "page" : undefined}
        href="/blog/"
      >
        blog
      </a>
      <a
        class="animated-link transition-colors hover:text-ink"
        aria-current={current.startsWith("/contact") ? "page" : undefined}
        href="/contact/"
      >
        contact
      </a>
    </nav>
  </div>
</header>
