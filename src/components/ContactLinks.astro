---
import { person } from "../data/site";
---

<div class="flex flex-wrap gap-3 text-sm">
  <a class="border border-line px-4 py-2 hover:border-accent" href={`mailto:${person.email}`}>Email</a>
  <a class="border border-line px-4 py-2 hover:border-accent" href={person.x}>X</a>
  <a class="border border-line px-4 py-2 hover:border-accent" href={person.linkedin}>LinkedIn</a>
  <a class="border border-line px-4 py-2 hover:border-accent" href={person.github}>GitHub</a>
</div>
